@startuml
title 4-Connect – Sequenzdiagramm Spielzug ausführen

skinparam defaultFontName Monospaced
skinparam ParticipantPadding 80
skinparam BoxPadding 50

skinparam SequenceLifeLineBorderColor #666666
skinparam SequenceLifeLineBackgroundColor transparent
skinparam SequenceArrowThickness 1

skinparam ResponseMessageBelowArrow true

actor "       Fluggast       " as Fluggast
|||
boundary "       FourConnectGameController       " as Controller
|||
control "       FourConnectGame       " as Game
|||
entity "       FourConnectPlayer       " as Player
|||
control "       FourConnectBotStrategy       " as Strategy
|||
control "       App       " as App



Fluggast -> Controller : handleColumnInput(column)
|||
alt game.getStatus() != GameState.Running
  Controller --> Fluggast : return
|||
else Spalte voll
  Controller -> Game : getBoard()
  Game --> Controller : FourConnectGameBoard
  Controller -> Controller : statusLabel.setText("Spalte ist voll!")
  Controller --> Fluggast : return
|||
else Zug möglich
  Controller -> Game : dropDisc(column)
  Game --> Controller : GameState

  Controller -> Controller : updateBoard()
  |||

  alt GameState == Won
    Controller -> App : setRoot("EndScreen")
  |||
  else GameState == Tied
    Controller -> App : setRoot("EndScreen")
  |||
  else GameState == Running
    Controller -> Game : playerTurn()
    Controller -> Controller : updateStatus()
  |||
  end
  |||

  alt oneBotPlayer == true
    Controller -> Controller : gridPane.setDisable(true)
    Controller -> Controller : botDelayTimer = new PauseTransition(Duration.seconds(1.0))
    Controller -> Controller : botDelayTimer.setOnFinished(event)

    Controller -> Game : playBotTurn()
    Game -> Player : getStrategy()
    Player --> Game : MoveStrategy

    Game -> Strategy : chooseMove(gameBoard)
    Strategy -> Game : dropDisc(botColumn)
    Game --> Strategy : GameState
    Strategy --> Game : GameState
    Game --> Controller : GameState

    Controller -> Controller : updateBoard()
    Controller -> Controller : gridPane.setDisable(false)
    |||

    alt GameState == Won
      Controller -> App : setRoot("EndScreen")
    |||
    else GameState == Tied
      Controller -> Controller : statusLabel.setText("Unentschieden!")
      Controller -> App : setRoot("EndScreen")
    |||
    else GameState == Running
      Controller -> Game : playerTurn()
      Controller -> Controller : updateStatus()
    |||
    end
    |||

    Controller -> Controller : botDelayTimer.play()
  else oneBotPlayer == false
  |||
  end
  |||
end
|||
|||
@enduml